# ==============================================================================
# Aegis Incident Resolution Platform - Environment Configuration
# Copy this file to .env and configure your keys before running.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Model & LLM Provider Configuration
# ------------------------------------------------------------------------------
# LLM Provider: "google" (recommended default), "openai", "anthropic", or "mock"
LLM_PROVIDER=google

# Gemini Model Name (e.g., gemini-3.5-flash-lite, gemini-2.5-flash, gemini-2.5-pro)
LLM_MODEL=gemini-3.5-flash-lite

# Google Gemini API Key (Required for live AI reasoning and tool calling)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Alternatively:
# LLM_API_KEY=your_gemini_api_key_here

# Optional: OpenAI / Anthropic API Keys (if using alternative LLM providers)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 2. TypeSafe / Jev AI Configuration (Fast Triage & Semantic Reranker)
# ------------------------------------------------------------------------------
# Enable or disable Jev AI fast triage (sub-20ms P1 classification)
USE_JEV_TRIAGE=true

# Enable or disable Jev Noul semantic reranker for runbook retrieval
USE_JEV_RERANKER=true

# Optional: Jev AI / Vercel AI Gateway API Key (falls back to local high-speed classifier if unset)
# AI_GATEWAY_API_KEY=
# TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 3. AcmeCloud Simulated Enterprise Digital Twin Connectivity
# ------------------------------------------------------------------------------
# AcmeCloud Digital Twin API endpoint (running via Docker Compose on port 8001)
ACME_CLOUD_API_URL=http://localhost:8001

# Set to false to connect directly to live AcmeCloud Docker containers & Prometheus.
# Set to true to use built-in in-memory fallback simulation if Docker is not running.
MOCK_ACME_CLOUD=false

# ------------------------------------------------------------------------------
# 4. Model Context Protocol (MCP) Configuration
# ------------------------------------------------------------------------------
# Enable FastMCP server tools (metrics, error logs, runbooks, docker inspection)
USE_MCP=true

# Transport mode: "direct" (in-process FastMCP adapter), "stdio", or "sse"
MCP_SERVER_TRANSPORT=direct

# ------------------------------------------------------------------------------
# 5. Platform & Tracing Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
TRACE_LOG_PATH=traces.jsonl
